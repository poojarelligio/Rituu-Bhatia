# Copy to .env.local and fill in real values. Never commit .env.local.

# MySQL connection (matches phpMyAdmin's connection to the same database)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=

# Long random string used to sign admin session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Razorpay — from your Razorpay Dashboard. Never expose the secret or
# webhook secret to the browser; only KEY_ID is used client-side.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Used to build absolute URLs (sitemap.xml, Open Graph tags, canonical links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
